# copy to .env, fill in, then: chmod 600 .env   (never commit it)
# Binance key: Enable Reading + Enable Spot Trading ONLY. Withdrawals OFF. Restrict to this VM's IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional: your own Telegram bot from @BotFather, and your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Claude reviews (console.anthropic.com). Set a spend limit there too.
ANTHROPIC_API_KEY=
