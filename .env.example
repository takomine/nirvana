# copy to .env, fill in, then: chmod 600 .env   (never commit it)
# Binance key: Enable Reading + Enable Spot Trading ONLY. Withdrawals OFF. Restrict to this VM's IP.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Phone alerts via ntfy (recommended): install the ntfy app, subscribe to this topic.
# Make it long and random - anyone who knows the name can read it. e.g.: echo nirvana-$(openssl rand -hex 12)
NTFY_TOPIC=
# Optional: your own ntfy server / access token
# NTFY_URL=https://ntfy.sh
# NTFY_TOKEN=
# Optional alternative: Telegram bot from @BotFather + your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Claude reviews (console.anthropic.com). Set a spend limit there too.
ANTHROPIC_API_KEY=
